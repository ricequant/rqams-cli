{
  "name": "@ricequant2026/rqams-cli",
  "version": "0.0.1",
  "description": "RQAMS CLI for AI agents",
  "bin": {
    "rqamsc": "bin/rqamsc.js"
  },
  "files": [
    "bin/",
    "docs/",
    "scripts/npm/",
    "README.md"
  ],
  "optionalDependencies": {
    "@ricequant2026/rqams-cli-linux-x64": "0.0.1",
    "@ricequant2026/rqams-cli-darwin-x64": "0.0.1",
    "@ricequant2026/rqams-cli-darwin-arm64": "0.0.1",
    "@ricequant2026/rqams-cli-win32-x64": "0.0.1"
  },
  "scripts": {
    "build:npm": "node scripts/npm/build-packages.js",
    "link:platform": "node scripts/npm/link-platform-package.js",
    "pack:all": "node scripts/npm/pack-all.js",
    "publish:all": "node scripts/npm/publish-all.js",
    "publish:next": "NPM_TAG=next node scripts/npm/publish-all.js",
    "publish:dry-run": "NPM_TAG=next NPM_DRY_RUN=1 node scripts/npm/publish-all.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "rqams",
    "cli",
    "agent",
    "ricequant"
  ],
  "engines": {
    "node": ">=18"
  }
}
